# EMITS PLTU Tenayan — backend environment template
# Copy to .env and fill in real values. Never commit .env to git.

MONGO_URL=mongodb://localhost:27017
DB_NAME=pltu_tenayan
JWT_SECRET=<generate-with-openssl-rand-hex-32>
CORS_ORIGINS=http://localhost:3013,http://127.0.0.1:3013,http://103.150.197.225:3013

# OpenRouter LLM provider (Phase 6, D-02 / D-04)
# Obtain API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=<operator-provides-from-openrouter-dashboard>
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
