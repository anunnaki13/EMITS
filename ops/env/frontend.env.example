# EMITS frontend production environment template.
# Copy to frontend/.env before yarn build. Never commit frontend/.env.

# If nginx serves frontend and proxies /api on the same host, use the site origin.
REACT_APP_BACKEND_URL=https://emits.example.internal
REACT_APP_BUILD_ID=<git-commit-or-build-id>

# Current direct-IP fallback if nginx/domain is not yet active:
# REACT_APP_BACKEND_URL=http://103.150.197.225:8013
