# EMITS backend production environment template.
# Copy to backend/.env on the host and fill real values there. Never commit backend/.env.

MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=pltu_tenayan
JWT_SECRET=<generate-with-openssl-rand-hex-32>
CORS_ORIGINS=https://emits.example.internal,http://103.150.197.225

# Optional global AI fallback. Prefer per-user keys when possible.
OPENROUTER_API_KEY=<openrouter-key-or-empty>
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini

# Backup automation defaults. Runtime settings can also be managed from Settings.
BACKUP_DIR=/opt/pltu-tenayan/backups/managed
